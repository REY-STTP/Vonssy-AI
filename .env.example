# ── Vonssy AI Environment Variables ──────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ── Supabase Postgres ────────────────────────────────────
# Use the Transaction Pooler connection string (port 6543) for serverless
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres

# ── Auth.js ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# GitHub OAuth (https://github.com/settings/applications/new)
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# ── AI Provider Keys (BYOK) ─────────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=your_random_secret_here

# Allow private/internal base URLs (dev only, e.g. Ollama). Default false.
# ALLOW_PRIVATE_BASE_URL=true

# ── App URL (for Auth.js callbacks) ─────────────────────
NEXTAUTH_URL=https://www.vonssy-ai.web.id

# ── Search Console / Webmaster verification (F5) ──────────
# Public-by-design tokens rendered as <meta> tags. Get them from:
# Google: Search Console → Settings → Verification
# Bing: Bing Webmaster Tools → Add site (msvalidate.01)
# Leave empty until verified — empty values emit no meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
